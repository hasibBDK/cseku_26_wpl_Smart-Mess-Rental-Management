PORT=5000
# Comma-separated list in production. Development also permits localhost ports.
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb+srv://YOUR_DATABASE_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/campusnest?retryWrites=true&w=majority

# Project ID is enough for ID-token verification. Service-account values below
# are optional until privileged Firebase Admin operations are added.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Only these Firebase accounts can register/use the admin role (comma-separated).
ADMIN_EMAILS=admin@example.com
